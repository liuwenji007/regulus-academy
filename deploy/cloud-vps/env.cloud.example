# Cloud Demo 环境变量模板（任意 Docker 主机）
# 用法：cp env.cloud.example .env && 填入密钥（.env 勿提交 Git）
#
# 生成密钥示例：
#   openssl rand -hex 32   # ADMIN_TOKEN / REGULUS_CLOUD_ENCRYPTION_KEY 各一次

REGULUS_DEPLOYMENT=cloud
PORT=8080
# 宿主机映射端口（8080 已被占用时改为其他端口）
HOST_PORT=8080
DATABASE_PATH=/app/data/regulus.db

LLM_PROVIDER=deepseek
LLM_API_KEY=

ADMIN_TOKEN=
REGULUS_CLOUD_ENCRYPTION_KEY=

# 公开页脚链接（上线后把 DEMO_URL 改成你的 HTTPS 域名）
REGULUS_CLOUD_GITHUB_URL=https://github.com/liuwenji007/regulus-academy
REGULUS_CLOUD_DOCS_URL=https://regulus-academy-docs.vercel.app
REGULUS_CLOUD_DEMO_URL=https://demo.awoshuile.cn

# 配额与限流
REGULUS_CLOUD_QUOTA_DAILY_MESSAGES=30
REGULUS_CLOUD_QUOTA_DAILY_BUILDS=3
REGULUS_CLOUD_MAX_BUILD_JOBS_GLOBAL=5
REGULUS_CLOUD_MAX_USERS_PER_IP_PER_DAY=5
REGULUS_CLOUD_RATE_LIMIT_PER_IP=60

# 公网 Demo 建议关闭 IM Gateway
GATEWAY_ENABLED=false

# Cloud 收紧 ingest / 建树
REGULUS_INGEST_MAX_PDF_BYTES=10485760
REGULUS_INGEST_MAX_PDF_PAGES=80
REGULUS_DOMAIN_BUILD_TIMEOUT_SEC=300
REGULUS_TREE_CRITIQUE=0

# 镜像（一般不用改；fork 可改成 ghcr.io/<owner>/regulus-academy:latest）
# REGULUS_IMAGE=ghcr.io/liuwenji007/regulus-academy:latest
